# ============================================
# Choix de l'adapter de base de données
# Valeurs possibles : supabase | firebase | sqlite | local
# ============================================
VITE_DB_ADAPTER=sqlite

# ---------- Supabase ----------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------- Firebase ----------
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# ---------- SQLite (dev only) ----------
# Nom du fichier dans le dossier sqlite du stockage local du navigateur (OPFS)
VITE_SQLITE_DB_NAME=school_store.db

# ---------- Base path (GitHub Pages project pages) ----------
VITE_BASE_PATH=/
